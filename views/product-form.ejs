<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1"/>
  <title><%= product ? 'Editar' : 'Nuevo' %> Producto</title>
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body>
  <header class="header">
    <img src="/logo.png" alt="logo" class="logo">
    <h1>Panel Admin</h1>
  </header>

  <main class="container">
    <h2><%= product ? 'Editar' : 'Nuevo' %> Producto</h2>

    <form action="<%= action %>" method="POST" enctype="multipart/form-data">
      <label>Título</label>
      <input type="text" name="title" value="<%= product ? product.title : '' %>" required>

      <label>Descripción</label>
      <textarea name="description"><%= product ? product.description : '' %></textarea>

      <label>Precio</label>
      <input type="number" name="price" step="0.01" value="<%= product ? product.price : '' %>" required>

      <label>Stock</label>
      <input type="number" name="stock" value="<%= product ? product.stock : 0 %>" required>

      <label>Categoría</label>
      <input type="text" name="category" value="<%= product ? product.category : '' %>" required>

      <label>Imagen (thumbnail)</label>
      <input type="file" name="thumbnail" accept="image/*">

      <% if (product && product.thumbnail) { %>
        <p>Imagen actual: <img src="<%= product.thumbnail %>" alt="" style="height:60px;"></p>
      <% } %>

      <div style="margin-top:12px;">
        <button type="submit" class="btn"><%= product ? 'Guardar cambios' : 'Crear producto' %></button>
        <a href="/admin/dashboard" class="btn">Volver</a>
      </div>
    </form>
  </main>
</body>
</html>
