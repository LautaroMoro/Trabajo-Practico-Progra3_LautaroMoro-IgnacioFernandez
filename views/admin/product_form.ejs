<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title><%= product ? 'Editar' : 'Nuevo' %> Producto</title>
  <link rel="stylesheet" href="/css/admin.css" />
</head>
<body>
  <%- include('../partials/header') %>
  <main class="container">
    <h2><%= product ? 'Editar' : 'Nuevo' %> producto</h2>

    <form action="<%= product ? '/admin/product/' + product.id + '?_method=PUT' : '/admin/product' %>" method="POST" enctype="multipart/form-data" class="product-form">
      <label for="nombre">Nombre</label>
      <input id="nombre" name="nombre" required value="<%= product ? product.nombre : '' %>" />

      <label for="tipo">Tipo / Categoría</label>
      <select id="tipo" name="tipo" required>
        <option value="tipoA" <%= product && product.tipo==='tipoA' ? 'selected' : '' %>>Tipo A</option>
        <option value="tipoB" <%= product && product.tipo==='tipoB' ? 'selected' : '' %>>Tipo B</option>
      </select>

      <label for="precio">Precio</label>
      <input id="precio" name="precio" type="number" step="0.01" required value="<%= product ? product.precio : '' %>" />

      <label for="activo">Activo</label>
      <input id="activo" name="activo" type="checkbox" <%= product && product.activo ? 'checked' : '' %> />

      <label for="imagen">Imagen</label>
      <input id="imagen" name="imagen" type="file" accept="image/*" />
      <div class="img-preview">
        <% if (product && product.imagenPath) { %>
          <img id="preview-img" src="/<%= product.imagenPath %>" alt="preview" />
        <% } else { %>
          <img id="preview-img" src="/images/placeholder.png" alt="preview" />
        <% } %>
      </div>

      <div class="form-actions">
        <button type="submit" class="btn primary">Guardar</button>
        <a href="/admin/dashboard" class="btn">Cancelar</a>
      </div>
    </form>
  </main>
  <%- include('../partials/footer') %>
</body>
</html>