<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Admin - Dashboard</title>
  <link rel="stylesheet" href="/css/admin.css" />
</head>
<body>
  <%- include('../partials/header') %>

  <main class="container">
    <section class="top-row">
      <h2>Productos</h2>
      <div class="controls">
        <a href="/admin/product/new" class="btn">+ Nuevo producto</a>
      </div>
    </section>

    <% if (flash) { %>
      <div class="alert success"><%= flash %></div>
    <% } %>

    <section class="product-table">
      <table>
        <thead>
          <tr>
            <th>Imagen</th>
            <th>Nombre</th>
            <th>Tipo</th>
            <th>Precio</th>
            <th>Activo</th>
            <th>Acciones</th>
          </tr>
        </thead>
        <tbody>
          <% products.forEach(p => { %>
            <tr class="product-row <%= p.activo ? '' : 'inactive' %>">
              <td class="img-cell"><img src="/<%= p.imagenPath %>" alt="<%= p.nombre %>"/></td>
              <td><%= p.nombre %></td>
              <td><%= p.tipo %></td>
              <td>$<%= p.precio.toFixed(2) %></td>
              <td><%= p.activo ? 'Sí' : 'No' %></td>
              <td class="actions">
                <a href="/admin/product/<%= p.id %>/edit" class="btn small">Editar</a>
                <% if (p.activo) { %>
                  <button class="btn small warn" data-action="deactivate" data-id="<%= p.id %>">Desactivar</button>
                <% } else { %>
                  <button class="btn small" data-action="activate" data-id="<%= p.id %>">Activar</button>
                <% } %>
                <button class="btn small danger" data-action="delete" data-id="<%= p.id %>">Eliminar</button>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>

      <!-- Paginación simple -->
      <nav class="pagination">
        <% if (page > 1) { %>
          <a href="?page=<%= page - 1 %>" class="page">« Anterior</a>
        <% } %>
        <span class="page current">Página <%= page %> de <%= totalPages %></span>
        <% if (page < totalPages) { %>
          <a href="?page=<%= page + 1 %>" class="page">Siguiente »</a>
        <% } %>
      </nav>
    </section>
  </main>

  <!-- Confirm modal -->
  <div id="confirm-modal" class="modal hidden">
    <div class="modal-content">
      <p id="confirm-text">¿Estás seguro?</p>
      <div class="modal-actions">
        <button id="confirm-yes" class="btn danger">Confirmar</button>
        <button id="confirm-no" class="btn">Cancelar</button>
      </div>
    </div>
  </div>

  <%- include('../partials/footer') %>
  <script src="/js/admin.js"></script>
</body>
</html>
